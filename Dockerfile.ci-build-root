# Build root image for JobSet's Prow tests, referenced as
# build_root.project_image (dockerfile_path) in the openshift/release
# ci-operator job configuration. Based on the public UBI9 Go toolset image.
#
# ci-operator clones the repository into /go/src while building the src
# image, running as this image's default user 1001, so /go/src must exist
# and be writable by that user.
FROM registry.access.redhat.com/ubi9/go-toolset:1.27

USER 0
RUN mkdir -p /go/src \
    && chown 1001:0 /go /go/src \
    && chmod 0775 /go /go/src
USER 1001

# Fail the checks instead of silently downloading a different toolchain when
# go.mod requires a newer Go than this image provides.
ENV GOTOOLCHAIN=local
